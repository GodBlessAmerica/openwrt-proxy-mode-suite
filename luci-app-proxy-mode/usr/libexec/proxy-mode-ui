#!/bin/sh
set -u

PROXY_MODE="/usr/bin/proxy-mode"
REGISTRY="proxy-mode"
DIR="/etc/sing-box"

valid_id() { case "$1" in ''|*[!0-9]*|0) return 1 ;; esac; [ "$1" -le 999 ] 2>/dev/null; }
base_file() { echo "$DIR/mode$1.json"; }
block_file() { echo "$DIR/mode$1-ipv6-block.json"; }
current_id() { current="$(uci -q get sing-box.main.conffile)"; basename -- "$current" 2>/dev/null | sed -n 's/^mode\([0-9][0-9]*\)\(-ipv6-block\)\{0,1\}\.json$/\1/p'; }
name_for() { id="$1"; name="$(uci -q get "${REGISTRY}.mode${id}.name")"; [ -n "$name" ] || name="Mode $id"; printf '%s' "$name"; }
set_name() { id="$1"; name="$2"; [ ${#name} -le 80 ] || { echo "ERROR: name too long" >&2; return 1; }; clean="$(printf '%s' "$name" | tr '\r\n\t' '   ')"; [ -n "$clean" ] || clean="Mode $id"; uci -q get "${REGISTRY}.mode${id}" >/dev/null 2>&1 || uci set "${REGISTRY}.mode${id}=mode"; uci set "${REGISTRY}.mode${id}.name=$clean"; uci commit "$REGISTRY"; }

list_modes() {
    cur="$(current_id)"; found=0
    for f in "$DIR"/mode*.json; do
        [ -f "$f" ] || continue
        case "$f" in *-ipv6-block.json) continue ;; esac
        id="$(basename "$f" | sed -n 's/^mode\([0-9][0-9]*\)\.json$/\1/p')"; valid_id "$id" || continue
        found=1; name="$(name_for "$id")"; active=0; [ "$id" = "$cur" ] && active=1; size="$(wc -c < "$f" | tr -d ' ')"
        printf '%s\t%s\t%s\t%s\n' "$id" "$active" "$size" "$name"
    done | sort -n -k1,1
    [ "$found" -eq 1 ] || true
}

read_mode() { id="$1"; valid_id "$id" || { echo "ERROR: invalid mode id" >&2; exit 2; }; f="$(base_file "$id")"; [ -f "$f" ] || { echo "ERROR: mode $id not found" >&2; exit 3; }; cat "$f"; }

save_mode() {
    id="$1"; content="$2"; valid_id "$id" || { echo "ERROR: invalid mode id" >&2; exit 2; }; f="$(base_file "$id")"; [ -f "$f" ] || { echo "ERROR: mode $id not found" >&2; exit 3; }
    tmp="$DIR/.mode${id}.gui.$$"; printf '%s' "$content" > "$tmp" || exit 4; chmod 600 "$tmp"
    if ! sing-box check -c "$tmp"; then echo "ERROR: sing-box check failed; original mode was not changed." >&2; rm -f "$tmp"; exit 5; fi
    ts="$(date +%Y%m%d-%H%M%S)"; cp -p "$f" "$f.bak.$ts" || { rm -f "$tmp"; exit 6; }; mv "$tmp" "$f"; rm -f "$(block_file "$id")"
    if [ "$(current_id)" = "$id" ]; then "$PROXY_MODE" restart || { echo "ERROR: saved, but current mode failed to restart; backup: $f.bak.$ts" >&2; exit 7; }; fi
    echo "Mode $id saved. Backup: $f.bak.$ts"
}

next_id() { id=1; while [ "$id" -le 999 ]; do [ ! -e "$(base_file "$id")" ] && { echo "$id"; return 0; }; id=$((id + 1)); done; return 1; }
ensure_free_id() { id="$1"; valid_id "$id" || { echo "ERROR: invalid mode id (1..999)" >&2; exit 2; }; [ ! -e "$(base_file "$id")" ] || { echo "ERROR: mode $id already exists" >&2; exit 3; }; }

create_mode() { source="$1"; name="$2"; valid_id "$source" || { echo "ERROR: invalid source mode" >&2; exit 2; }; src="$(base_file "$source")"; [ -f "$src" ] || { echo "ERROR: source mode $source not found" >&2; exit 3; }; id="$(next_id)" || { echo "ERROR: no free mode id" >&2; exit 4; }; cp -p "$src" "$(base_file "$id")" || exit 5; chmod 600 "$(base_file "$id")"; set_name "$id" "$name" || { rm -f "$(base_file "$id")"; exit 6; }; echo "$id"; }
create_mode_id() { id="$1"; source="$2"; name="$3"; ensure_free_id "$id"; valid_id "$source" || { echo "ERROR: invalid source mode" >&2; exit 4; }; src="$(base_file "$source")"; [ -f "$src" ] || { echo "ERROR: source mode $source not found" >&2; exit 5; }; cp -p "$src" "$(base_file "$id")" || exit 6; chmod 600 "$(base_file "$id")"; set_name "$id" "$name" || { rm -f "$(base_file "$id")"; exit 7; }; echo "$id"; }

create_json_mode() { name="$1"; content="$2"; id="$(next_id)" || { echo "ERROR: no free mode id" >&2; exit 4; }; create_json_mode_id "$id" "$name" "$content"; }
create_json_mode_id() { id="$1"; name="$2"; content="$3"; ensure_free_id "$id"; f="$(base_file "$id")"; tmp="$DIR/.mode${id}.new.$$"; printf '%s' "$content" > "$tmp" || exit 5; chmod 600 "$tmp"; if ! sing-box check -c "$tmp"; then echo "ERROR: sing-box check failed; mode was not created." >&2; rm -f "$tmp"; exit 6; fi; mv "$tmp" "$f" || exit 7; set_name "$id" "$name" || { rm -f "$f"; exit 8; }; echo "$id"; }

delete_mode() { id="$1"; valid_id "$id" || { echo "ERROR: invalid mode id" >&2; exit 2; }; [ -f "$(base_file "$id")" ] || { echo "ERROR: mode $id not found" >&2; exit 3; }; [ "$(current_id)" != "$id" ] || { echo "ERROR: current mode cannot be deleted. Switch to another mode first." >&2; exit 4; }; backup_dir="/root/proxy-mode-deleted"; mkdir -p "$backup_dir"; ts="$(date +%Y%m%d-%H%M%S)"; mv "$(base_file "$id")" "$backup_dir/mode${id}.json.$ts" || exit 5; [ ! -f "$(block_file "$id")" ] || mv "$(block_file "$id")" "$backup_dir/mode${id}-ipv6-block.json.$ts"; uci -q delete "${REGISTRY}.mode${id}"; uci commit "$REGISTRY"; echo "Mode $id deleted. Backup saved under $backup_dir."; }
rename_mode() { id="$1"; name="$2"; valid_id "$id" || { echo "ERROR: invalid mode id" >&2; exit 2; }; [ -f "$(base_file "$id")" ] || { echo "ERROR: mode $id not found" >&2; exit 3; }; set_name "$id" "$name" || exit 4; echo "Mode $id renamed to: $(name_for "$id")"; }

case "${1:-}" in
    list) list_modes ;;
    read) read_mode "${2:-}" ;;
    save) save_mode "${2:-}" "${3:-}" ;;
    create) create_mode "${2:-}" "${3:-New Mode}" ;;
    create-id) create_mode_id "${2:-}" "${3:-}" "${4:-New Mode}" ;;
    create-json) create_json_mode "${2:-New Mode}" "${3:-}" ;;
    create-json-id) create_json_mode_id "${2:-}" "${3:-New Mode}" "${4:-}" ;;
    delete) delete_mode "${2:-}" ;;
    rename) rename_mode "${2:-}" "${3:-}" ;;
    *) echo "usage: proxy-mode-ui list|read ID|save ID JSON|create SOURCE NAME|create-id ID SOURCE NAME|create-json NAME JSON|create-json-id ID NAME JSON|delete ID|rename ID NAME" >&2; exit 1 ;;
esac
